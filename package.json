{
  "name": "token-floor",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haesoo-y/token-floor.git"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @token-floor/server\" \"npm run dev -w @token-floor/web\"",
    "build": "npm run build -w @token-floor/adapter-codex && npm run build -w @token-floor/adapter-claude && npm run build -w @token-floor/server && npm run build -w @token-floor/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
